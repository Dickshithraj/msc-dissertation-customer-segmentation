# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb

# Data files — keep raw source under version control; exclude large processed artefacts
data/processed/*
!data/processed/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# Pytest cache
.pytest_cache/
.cache/

# Coverage
htmlcov/
.coverage
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini

# Secrets / env
.env
*.pem
*.key

# Streamlit secrets
app/.streamlit/secrets.toml


.claude/*

# Not part of the submission
/SoC-report-Template.docx
docs/dissertation/vani_backup_*.docx
docs/dissertation/Marking Guidance*.pdf
